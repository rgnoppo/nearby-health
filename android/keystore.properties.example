# Local-dev convenience file — copy to `keystore.properties` (same folder)
# and fill in real values ONLY on your own machine. This example file has no
# secrets and is safe to commit; the real `keystore.properties` is gitignored
# and must never be committed.
#
# CI / production builds should NOT use this file at all — set the
# environment variables below instead (see android/README-SIGNING.md):
#   ANDROID_KEYSTORE_PATH, ANDROID_KEYSTORE_PASSWORD,
#   ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD

storeFile=app/release.keystore
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
